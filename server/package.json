{
  "name": "travel-io-api-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "init:sqlite": "node --loader ts-node/esm src/scripts/init-sqlite.ts",
    "dev": "npm run init:sqlite && cross-env NODE_ENV=development nodemon --watch src --ext ts --exec \"npm run dev:run\"",
    "dev:run": "node --loader ts-node/esm src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=dist/index.js --external:pg --external:@mapbox/node-pre-gyp --external:mock-aws-s3 --external:aws-sdk --external:nock --loader:.html=text",
    "typecheck": "tsc --noEmit",
    "migrate": "knex migrate:latest --knexfile knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.10.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.11.1",
    "pino": "^8.16.0",
    "pino-http": "^8.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.17",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.20.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.0",
    "knex": "^2.5.1",
    "nodemon": "^3.1.3",
    "pino-pretty": "^10.2.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.4"
  }
}
